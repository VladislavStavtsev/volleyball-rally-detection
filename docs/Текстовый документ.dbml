// e-commerce
Table users {
  id int [pk]
  email varchar [unique, note: 'login email, must be unique']
  name varchar
  created_at timestamp
  Note: 'Registered customers'
}

Table categories {
  id int [pk]
  name varchar
}

Table products {
  id int [pk]
  name varchar
  price decimal [note: 'unit price in USD']
  category_id int [ref: > categories.id]
  Note: 'Catalog items for sale'
}

Table orders {
  id int [pk]
  user_id int [ref: > users.id]
  status varchar [note: '1=processing, 2=shipped, 3=cancelled']
  total decimal
  created_at timestamp
  Note: 'Customer orders'
}

Table order_items {
  id int [pk]
  order_id int [ref: > orders.id]
  product_id int [ref: > products.id]
  quantity int
}

Records categories (id, name) {
  1, 'Peripherals'
  2, 'Displays'
  3, 'Audio'
  4, 'Accessories'
}

